# Copy to .env and adjust. compose.yaml reads the POSTGRES_* vars directly;
# app/config.py reads all of these via pydantic-settings.
POSTGRES_USER=docreview
POSTGRES_PASSWORD=docreview
POSTGRES_DB=docreview

# Connection string for FastAPI (app/db.py) and, later, the LangGraph
# Postgres checkpointer. Host is localhost from your machine (Postgres runs
# in Docker with port 5432 published), or "db" from inside another container
# on the same compose network.
DATABASE_URL=postgresql://docreview:docreview@localhost:5432/docreview

# LLM provider — required once app/graph/agent.py is implemented.
ANTHROPIC_API_KEY=
# Only needed if the key above is "identity-linked" (tied to your Console
# account across multiple workspaces) rather than scoped to one workspace —
# find it at console.anthropic.com under the workspace's settings.
ANTHROPIC_WORKSPACE_ID=
# Langfuse tracing — optional; app runs fine without these, tracing no-ops
# (see app/graph/tracing.py). Get keys at cloud.langfuse.com (free tier) or
# from a self-hosted instance — BASE_URL only needs changing for self-hosting.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
